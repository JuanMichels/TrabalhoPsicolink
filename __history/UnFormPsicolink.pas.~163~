unit UnFormPsicolink;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants,
  System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.Imaging.pngimage,
  Vcl.WinXPanels, Vcl.StdCtrls, Vcl.Mask, psicolink2, UnDMPrincipal, Data.DB,
  UnCadastro,
  Vcl.DBCtrls, UnAgenda, UnTelaPrincipal, UnTelaPrincipalPsicologo;

type
  Tformlogin = class(TForm)
    painel_superior: TPanel;
    painel_inferior: TPanel;
    sub_painel: TPanel;
    Image1: TImage;
    menu_central: TPanel;
    Prosseguir: TPanel;
    Edit1: TEdit;
    Edit2: TEdit;
    Cadastro: TPanel;
    CPFEdit: TMaskEdit;
    SenhaEdit: TMaskEdit;
    CheckBox1: TCheckBox;
    Label1: TLabel;
    CRP: TDBEdit;
    Label2: TLabel;
    procedure FormCreate(Sender: TObject);
    procedure CadastroClick(Sender: TObject);
    procedure CheckBox1Click(Sender: TObject);
    procedure ProsseguirClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }

  end;

var
  formlogin: Tformlogin;

implementation

uses
  DMUnCadastro;

{$R *.dfm}

procedure Tformlogin.FormCreate(Sender: TObject);
begin
  DMPrincipalP.buscarbanco;
  self.CPFEdit.Text := '08840214917';
  self.CRP.Text := '123456';
  self.SenhaEdit.Text := '123456';
end;

procedure Tformlogin.CadastroClick(Sender: TObject);
var
  LFormCadastro: TUnFormCadastro;
begin
  LFormCadastro := TUnFormCadastro.create(self);
  try
    LFormCadastro.showModal;
  finally
    FreeAndNil(LFormCadastro)
  end;
end;

procedure Tformlogin.CheckBox1Click(Sender: TObject);
begin
  if CheckBox1.Checked then
  begin
    CRP.Visible := True;
    CPFEdit.Visible := False;
    Edit2.Visible := False;
    Label1.Visible := True;
  end
  else
  begin
    CRP.Visible := False;
    CPFEdit.Visible := True;
    Edit2.Visible := True;
    Label1.Visible := False;
  end;

end;

procedure Tformlogin.ProsseguirClick(Sender: TObject);
var
  LFormtela: TFormPrincipal;
  Lformpsico: TFormprincipalpsicologo;
begin
  DMPrincipalP := TDMPrincipalP.create(nil);
  LFormtela := TFormPrincipal.create(nil);
  Lformpsico := TFormprincipalpsicologo.create(nil);

  // DMPrincipalP.conectarbanco;

  DMPrincipalP.FDQuery.close;
  DMPrincipalP.FDQuery.SQL.Clear;

  if CheckBox1.Checked then
  begin
    DMPrincipalP.QRYPsicologo.close;
    DMPrincipalP.QRYPsicologo.SQL.Clear;
    DMPrincipalP.QRYPsicologo.SQL.Add
      ('SELECT psicologo.crp, psicologo.id_pessoa' + #13 + 'FROM psicologo' +
      #13 + 'WHERE psicologo.crp = :crp');
    // DMPrincipalP.FDQuery.SQL.Add('Select pessoa.id, psicologo.id_pessoa' + #13 +
    // 'from pessoa' + #13 + 'join psigologo on pessoa.id = psicologo.id_pessoa');
    // DMPrincipalP.QRYPsicologo.SQL.Add('SELECT * from psicologo WHERE psicologo.crp = :crp');
    DMPrincipalP.QRYPsicologo.ParamByName('crp').AsString := CRP.Text;

    DMPrincipalP.QRYPsicologo.open;

  DMPrincipalP.FDQuery.SQL.Add
    ('SELECT * FROM pessoa WHERE senha = :senha');
  DMPrincipalP.FDQuery.ParamByName('senha').AsString := SenhaEdit.Text;
  end
  else
  begin

    DMPrincipalP.FDQuery.SQL.Add
      ('SELECT * FROM pessoa WHERE cpf = :cpf');

    DMPrincipalP.FDQuery.ParamByName('cpf').AsString := CPFEdit.Text;

  end;

  DMPrincipalP.FDQuery.open;

  if (DMPrincipalP.FDQuery.RecordCount > 0) then
  begin

    if CheckBox1.Checked then
    begin
      try
        DMPrincipalP.UsuarioID := DMPrincipalP.QRYPsicologo.FieldByName
          ('id_pessoa').AsInteger;
        ShowMessage('Login realizado com sucesso!' + sLineBreak +
          'Bem vindo Usuario:' + (' ') + DMPrincipalP.FDQuerynome.Value);
        DMPrincipalP.Nome := DMPrincipalP.FDQuerynome.Value;
        Lformpsico.showModal;
      finally
        FreeAndNil(Lformpsico);
      end;
    end
    else
    begin
      try
        DMPrincipalP.UsuarioID := DMPrincipalP.FDQuery.FieldByName('id')
          .AsInteger;
        ShowMessage('Login realizado com sucesso!' + sLineBreak +
          'Bem vindo Usuario:' + (' ') + DMPrincipalP.FDQuerynome.Value);
        DMPrincipalP.Nome := DMPrincipalP.FDQuerynome.Value;
        LFormtela.showModal;
      finally
        FreeAndNil(LFormtela);
      end;

    end;

    self.hide;
  end
  else
  begin
    ShowMessage('Usuario ou senha inválidos!');
  end;

end;

end.
