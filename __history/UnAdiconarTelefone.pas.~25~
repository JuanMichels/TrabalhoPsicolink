unit UnAdiconarTelefone;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants,
  System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.DBCtrls, Vcl.Mask,
  Vcl.ExtCtrls, Vcl.Imaging.pngimage, UnDMTelefone, Data.DB, Vcl.Grids,
  Vcl.DBGrids, UnDMPrincipal;

type
  TFormTelefone = class(TForm)
    painel_superior: TPanel;
    Image1: TImage;
    sub_painel: TPanel;
    painel_inferior: TPanel;
    menu_central: TPanel;
    Label1: TLabel;
    DBEdit1: TDBEdit;
    DBGrid1: TDBGrid;
    Salvar: TButton;
    procedure FormShow(Sender: TObject);
    procedure SalvarClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormTelefone: TFormTelefone;
  DMTelefone: TDMTelefone;

implementation

{$R *.dfm}

procedure TFormTelefone.FormShow(Sender: TObject);
begin
  DMTelefone := TDMTelefone.create(nil);
  DMTelefone.QRYContato.close;
  DMTelefone.QRYContato.SQL.Clear;
  DMTelefone.QRYContato.SQL.Add('Select c.contato1, p.nome from contatos as c join pessoa as p on p.id = c.fk_pessoas');
  DMTelefone.QRYContato.Open;

  DMTelefone.QRYPessoa.close;
  DMTelefone.QRYPessoa.SQL.Clear;
  DMTelefone.QRYPessoa.SQL.Add(Format('Select * from pessoa where id =  %0:d',
    [DMPrincipalP.Usuarioid]));
  DMTelefone.QRYPessoa.Open;

  DMTelefone.QRYContato.Append;
  DMTelefone.QRYPessoa.Append;

end;

procedure TFormTelefone.SalvarClick(Sender: TObject);
begin
  DMTelefone.QRYContato.ApplyUpdates();
  DMTelefone.QRYContato.CommitUpdates;

  DMTelefone.QRYPessoa.ApplyUpdates();
  DMTelefone.QRYPessoa.CommitUpdates;

  DMTelefone.QRYContato.Append;
  DMTelefone.QRYPessoa.Append;
end;

end.
